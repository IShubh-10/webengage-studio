# ============================================================================
# Webengage Creative Studio — environment
# ----------------------------------------------------------------------------
# Copy to .env and fill in. server.js reads .env on startup (no dependency
# needed); anything already exported in the environment takes precedence.
#
#   cp .env.example .env      then restart:  npm start
# ============================================================================

# --- Sessions ---------------------------------------------------------------
# REQUIRED. Encrypts and authenticates the login cookie. Without it the server
# falls back to a default that is written in config/index.js and therefore
# visible to anyone who can read this repository — which means anyone who can
# read it could mint a token for any account, including an admin one.
#
# With NODE_ENV=production the server refuses to start unless this is set, so
# set it in the deployment environment (Render: Environment -> Add) as well as
# here. Changing it signs everyone out, so pick the moment deliberately.
#   generate:  openssl rand -base64 32
SESSION_SECRET=

# --- Registration OTP (WebEngage transactional SMS campaign) ----------------
# REQUIRED for the 4 digit code to actually be delivered. Without it the code is
# only printed in the server log. Copy the key from the WebEngage dashboard —
# the "WebEngage API Key" link on the campaign's launch page, under your
# account menu > Settings.
WEBENGAGE_API_KEY=

# The transactional campaign that sends the SMS. Defaults to the campaign this
# studio was built against, so only set it to point at a different campaign.
# WEBENGAGE_OTP_URL=https://api.webengage.com/v2/accounts/76aba26/experiments/~24clqpf/transaction

# How long WebEngage should keep trying to deliver, in seconds (campaign ttl).
# WEBENGAGE_OTP_TTL=60

# The WebEngage user the transactional campaign is triggered against. The SMS
# recipient comes from the phone number in the payload, so this stays static.
# WEBENGAGE_OTP_USER_ID=shubham01

# How long a code stays valid on our side, in seconds.
# OTP_TTL_SECONDS=300

# Dial code prefixed to the 10 digit number when the SMS goes out.
# PHONE_COUNTRY_CODE=+91

# --- Registration policy ----------------------------------------------------
# Restrict self-registration to one email domain, e.g. webengage.com
# ALLOWED_EMAIL_DOMAIN=

# --- MySQL ------------------------------------------------------------------
# REQUIRED in any environment whose database is not a passwordless root on
# localhost:3306. src/config/db.js has no hardcoded fallbacks — a managed
# database hands you a host, a port and a password, and none of those belong in
# the repository.
#
# The port matters: managed MySQL multiplexes many databases behind one address,
# so it is rarely 3306 (e.g. 39120).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=personalize_studio

# TLS to the database. Unset for a local server; a hosted one is reached over
# the public internet and should always encrypt.
#   true          verify against the system CA store
#   skip-verify   encrypt without verifying (self-signed certificates)
# DB_SSL=true
# DB_SSL_CA=certs/mysql-ca.pem     # path (relative to the repo root) to the provider's CA

# --- Redis (template + render + OTP cache) ----------------------------------
# A hosted instance is handed over as one URL — set REDIS_URL and ignore the
# rest. `rediss://` (two s) is the TLS form used from outside the provider's
# network. For a local install leave it unset and the host/port apply.
# With NODE_ENV=production and none of these set, src/config/redis.js falls back
# to the Render Key Value instance's internal URL, which only resolves inside
# Render — so leave them unset locally to get 127.0.0.1.
# REDIS_URL=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Server -----------------------------------------------------------------
# PORT=3000
# NODE_ENV=production
# WORKERS=4

# --- Capacity ---------------------------------------------------------------
# The MySQL pool is per worker, so what matters is the product. Set the budget
# for the whole cluster here and each worker takes its share; keep it under the
# database's max_connections (151 by default) or the server starts refusing
# connections long before it is actually busy.
# DB_POOL_TOTAL=60
# DB_CONNECTION_LIMIT=            # overrides the DB_POOL_TOTAL / WORKERS split
# DB_QUEUE_LIMIT=100              # 0 would mean queue forever; it never should

# Renders in flight, and how many may wait. Past the queue limit the server
# answers 503 with a Retry-After instead of parking work nobody is waiting for.
# Measured locally: 16/1024 absorbs 1,200 simultaneous opens at ~475/s.
# Raising the concurrency lowers throughput — the process gets slower to accept.
# RENDER_CONCURRENCY=16
# RENDER_QUEUE_LIMIT=1024

# Frames per pause during GIF encoding. Encoding is synchronous, so this is what
# stops one render from stalling every other request behind it. 0 disables it.
# RENDER_YIELD_FRAMES=8

# --- Per-IP rate limits ------------------------------------------------------
# The GIF ceiling is deliberately high: Gmail fetches every recipient's copy
# through a small pool of Google addresses, so one IP legitimately accounts for
# a whole campaign. The auth ceiling is deliberately low — that endpoint sends
# real messages that cost real money.
# RATE_LIMIT_GIF=600
# RATE_LIMIT_AUTH=10
# RATE_LIMIT_WINDOW_SECONDS=60

# The load-testing switch. A load generator runs from one address and would
# otherwise trip the per-IP limit in seconds, so the run would measure the
# limiter rather than the service. This bypasses every limit; the concurrency
# limiter above still applies, which is usually the thing worth measuring.
# Leaving it off in production is an open door — the server warns on every boot.
# RATE_LIMIT_ENABLED=false

# Per-IP ceiling for the public render endpoint, which had none until now.
# RATE_LIMIT_RENDER=600

# --- Outbound image fetching -------------------------------------------------
# A template may use a placeholder as an image source, so `?image=…` on the
# public render endpoint is a URL the *caller* chooses and this server fetches.
# lib/urlGuard.js refuses anything that is not http(s) or that resolves to a
# private address, which is what stops that endpoint being a read primitive on
# the private network.
#
# Setting an allowlist is strictly stronger, and is the only thing that closes
# DNS rebinding. Leave it empty to allow any public host.
# IMAGE_HOST_ALLOWLIST=res.cloudinary.com,afiles.webengage.com,email-editor-resources.s3.amazonaws.com

# Largest image the server will pull down, in bytes. The response is held in
# memory to hand to sharp, so an unbounded one is an unbounded allocation.
# IMAGE_MAX_BYTES=12582912

# How long to wait for a remote image. Node's built-in fetch ignores
# node-fetch's `timeout` option, so before this there was no timeout at all.
# IMAGE_FETCH_TIMEOUT_MS=10000

# How long a URL's allow/refuse verdict is remembered. The check runs ahead of
# the image caches, so without this every render would pay a DNS lookup.
# IMAGE_GUARD_TTL_MS=300000

# Native threads sharp may use, per worker. Defaults to cores / workers —
# a flat value per worker oversubscribes the box and costs throughput.
# SHARP_CONCURRENCY=

# --- Countdown timers -------------------------------------------------------
# One frame per second, so this is also how long the animation runs.
# TIMER_FRAMES=60
# TIMER_MAX_FRAMES=120

# A creative wider than this is scaled down before any GIF work. Frame zero is
# the only full-canvas frame but it dominates both bytes and CPU, and email
# clients cap display width around 600px anyway.
# TIMER_MAX_CANVAS_WIDTH=1200

# How long a built sprite bundle (palette, quantised background, digit tiles)
# stays in Redis. Building one costs ~450ms; serving from it costs ~7ms.
# TIMER_SPRITE_TTL_SECONDS=21600
# TIMER_SPRITE_MEMORY_SLOTS=24

# Two opens of the same campaign in the same second want byte-identical GIFs,
# and on a large send there are thousands of them. Held server-side only — the
# response still goes to the recipient with no-store.
# TIMER_RESPONSE_CACHE_SECONDS=2
# TIMER_EXPIRED_CACHE_SECONDS=3600

# How long an evergreen timer remembers when a recipient first opened.
# TIMER_EVERGREEN_TTL_SECONDS=7776000

# The saved timer row, cached in front of MySQL. This runs once per email open,
# so it is the one lookup that must not reach the database on the hot path.
# TIMER_CONFIG_CACHE_SECONDS=300     # in Redis, shared by every worker
# TIMER_CONFIG_MEMORY_SECONDS=30     # per worker; also the fallback if Redis is down
# TIMER_CONFIG_MEMORY_SLOTS=256

# Only one worker builds a given sprite bundle; the others wait for its result
# rather than each spending ~450ms of CPU on the same thing.
# TIMER_SPRITE_LOCK_MS=20000         # how long the builder may hold the lock
# TIMER_SPRITE_LOCK_WAIT_MS=8000     # how long the others wait before building anyway

# Template rows, in front of the Redis copy.
# TEMPLATE_MEMORY_SECONDS=30
# TEMPLATE_MEMORY_SLOTS=256
# TEMPLATE_CACHE_SECONDS=86400
